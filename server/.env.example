# Copy to .env next to docker-compose.yml (docker compose reads it automatically)

# ESP32 address. Give the ESP32 a fixed IP with a DHCP reservation on the router.
ESP32_IP=192.168.1.231

# Timezone for the clock and timestamps on the display
TZ=Europe/Vilnius

# bridge (default) or host (Linux only: container joins the host network directly)
DOCKER_NETWORK_MODE=bridge

# MCP endpoint (/mcp/) for Claude. Empty = off. Generate with: openssl rand -hex 32
MCP_TOKEN=
# Minimum seconds between display updates made over MCP
MCP_MIN_PUSH_SECONDS=10

# Cloudflare Tunnel token (only for: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
